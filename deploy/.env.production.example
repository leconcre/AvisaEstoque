# =============================================================================
# AvisaEstoque — variáveis de PRODUÇÃO.
# =============================================================================
# Não comitar este arquivo com valores reais.
# No Coolify, cole cada par chave=valor na seção "Environment Variables" da
# Application (todas marcadas como "Build Variable" = false, exceto onde
# anotado abaixo).
# =============================================================================

# --- Runtime ---
NODE_ENV=production
TZ=America/Sao_Paulo
# debug em prod só temporariamente para diagnóstico — deixe info por padrão.
LOG_LEVEL=info

# --- Banco de dados (Neon — mantido por enquanto, vide DEPLOY.md §"Quando migrar pro Coolify") ---
# Endpoint POOLED (com "-pooler" no hostname). Usado pelo app em runtime.
DATABASE_URL="postgresql://<user>:<senha>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require"
# Endpoint DIRETO (sem "-pooler"). Usado pelo `prisma migrate deploy` no boot.
# É o MESMO hostname acima, removendo o sufixo "-pooler".
DIRECT_URL="postgresql://<user>:<senha>@<host>.<region>.aws.neon.tech/<db>?sslmode=require"

# --- NextAuth v5 ---
# IMPORTANTE: ESTE SEGREDO É DIFERENTE DO DEV.
# Gerar com:  openssl rand -base64 48
AUTH_SECRET="<NOVO_segredo_de_pelo_menos_32_caracteres_aleatorios>"
# DEVE estar em HTTPS — cookies "Secure" do NextAuth não funcionam em http.
AUTH_URL="https://app.<seu-dominio>"
AUTH_TRUST_HOST=true

# --- Cron (in-process) ---
# Como o VPS é always-on, ligamos o node-cron interno. Cron HTTP externo NÃO
# é usado neste deploy. Vide DEPLOY.md §"Caminho A" do README.
CRON_ENABLED=true
# Segredo do trigger manual POST /api/cron/run. Mantenha mesmo com cron interno
# ligado — facilita debugging e backup manual.
# Gerar com:  openssl rand -hex 32
CRON_SECRET="<segredo_hex_32_bytes>"

# --- WhatsApp Provider — DESATIVADO NO MVP ---
# O MVP em produção opera SOMENTE com notificação in-app. O stack do Evolution
# documentado em deploy/docker-compose.evolution.yml e em DEPLOY.md §4-5 NÃO
# precisa ser provisionado pra subir o app.
#
# Estas variáveis ficam aqui pra referência futura. Quando reativar o canal
# WhatsApp (vide src/lib/notifications/registry.ts), descomente:
WHATSAPP_PROVIDER=mock
# EVOLUTION_API_URL="http://evolution-api:8080"
# EVOLUTION_API_KEY="<api_key_do_evolution>"
# EVOLUTION_INSTANCE="avisaestoque-prod"
