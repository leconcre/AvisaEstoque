# --- App ---
NODE_ENV=development
TZ=America/Sao_Paulo
LOG_LEVEL=debug

# --- Banco de dados (PostgreSQL 16) ---
# Em docker-compose use o host "postgres"; localmente, "localhost"
# Em Neon use o endpoint com "-pooler" (PgBouncer).
DATABASE_URL="postgresql://avisa:avisa@localhost:5432/avisaestoque?schema=public"
# URL direta (sem pooler) — usada por migrate/db push.
# Em dev local pode ser igual a DATABASE_URL.
# Em Neon: mesmo hostname SEM o "-pooler" (ex: ep-foo-bar.region.aws.neon.tech).
DIRECT_URL="postgresql://avisa:avisa@localhost:5432/avisaestoque?schema=public"

# --- NextAuth v5 ---
# Gere com: openssl rand -base64 32
AUTH_SECRET="troque-em-producao-min-32-chars-aleatorios"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# --- Cron / Jobs ---
# Header esperado em POST /api/cron/run (apenas dev/teste manual)
CRON_SECRET="troque-em-producao"
# Liga o scheduler interno (node-cron) ao subir o processo. Em dev, false (dispara manual).
CRON_ENABLED=false

# --- Assistant Provider (Fase 8) ---
# Opções: "mock" (default, ativo no MVP) | "anthropic" (STUB) | "ollama" (STUB)
# Mock = roteamento por palavras-chave + tools determinísticas. Sem LLM, zero custo.
ASSISTANT_PROVIDER=mock

# Para ATIVAR Anthropic (Claude classe Haiku):
#   1. npm install @anthropic-ai/sdk
#   2. Implemente o TODO em src/lib/assistant/providers/anthropic.ts
#   3. Defina ANTHROPIC_API_KEY abaixo + ASSISTANT_PROVIDER=anthropic
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL=claude-haiku-4-5

# Para ATIVAR Ollama (LLM local on-prem):
#   1. Suba o Ollama (`ollama pull llama3.1:8b-instruct`)
#   2. Implemente o TODO em src/lib/assistant/providers/ollama.ts
#   3. Defina as duas envs abaixo + ASSISTANT_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b-instruct

# --- WhatsApp Provider — DESATIVADO NO MVP ---
# O MVP opera somente com notificação in-app (sino no TopBar).
# O canal WhatsApp/Evolution foi movido para src/lib/notifications/channels/_disabled/
# e estas variáveis NÃO são lidas pelo caminho quente do app. Pode deixar todas vazias.
#
# Para reativar: vide src/lib/notifications/registry.ts "PREMIUM (RECUPERÁVEL)".
WHATSAPP_PROVIDER=mock
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE=""
